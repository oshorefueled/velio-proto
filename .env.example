# Copy to .env for local development: cp .env.example .env
# Every value below is a non-secret local development default for this
# prototype (no production auth; see PLANS.md section 1). Do not reuse
# them outside this machine.

# --- Docker Compose: PostgreSQL bootstrap (first volume init only) ---
POSTGRES_PASSWORD=postgres_dev
VELIO_APP_PASSWORD=velio_app_dev
VELIO_MIGRATOR_PASSWORD=velio_migrator_dev

# --- Backend service ---
# Application role: DML only, no DDL.
DATABASE_URL=postgres://velio_app:velio_app_dev@localhost:55432/velio
# Migration role: owns schema objects; npm run migrate connects with this.
MIGRATION_DATABASE_URL=postgres://velio_migrator:velio_migrator_dev@localhost:55432/velio
REDIS_URL=redis://localhost:56379
# Database pool sizing and budgets (recorded per PLANS.md 5.2)
DATABASE_POOL_MAX=64
DATABASE_CONNECT_TIMEOUT_MS=5000
# Booking transaction budgets (SET LOCAL inside the booking transaction)
BOOKING_LOCK_TIMEOUT_MS=2000
BOOKING_STATEMENT_TIMEOUT_MS=5000
# Finite booking quotas per fixed window (429 with Retry-After beyond these)
BOOKING_RATE_LIMIT_PER_IDENTITY=30
BOOKING_RATE_LIMIT_PER_IP=120
BOOKING_RATE_WINDOW_SECONDS=3600
PORT=3001
# Finite readiness probe budget in milliseconds. A dependency that does not
# answer within this budget is reported unavailable, never healthy. This same
# budget currently bounds the connection pool's PostgreSQL statement timeout;
# the booking-path lock/statement timeouts are separately selected and
# recorded with the booking capability (PLANS.md section 5.2, ticket #4).
READY_CHECK_TIMEOUT_MS=2000
# Demo session lifetime in hours. Selected value: 12 — a demo session spans a
# full testing day, after which the person must select their identity again.
# Expiry never substitutes another person; the contact key resolves the same
# user every time (PLANS.md 5.2 requires this lifetime to be recorded).
DEMO_SESSION_TTL_HOURS=12
# Invitation experiment (PLANS.md 3.6): every activity is randomly assigned
# treatment or control inside its creation transaction and the saved
# assignment never changes. A rollout change ships as a new version plus a
# new allocation; previous assignments stay untouched. The switch gates only
# invite creation (enforced by the invite routes in tickets #6/#7); switching
# off never revokes issued invitations and never blocks ordinary booking.
# Selected value: 10% treatment under version rollout-1, creation on.
EXPERIMENT_VERSION=rollout-1
EXPERIMENT_TREATMENT_ALLOCATION_PERCENT=10
EXPERIMENT_INVITE_CREATION_ENABLED=true
# Invitations (tickets #6/#7): every invite carries an unpredictable typeable
# code and expires at the earlier of the configured lifetime and the activity
# start. Creation quotas are finite fixed windows per identity and per IP;
# anonymous code resolution is quotaed per IP. The creation switch gates only
# creation: issued invites stay claimable and ordinary booking never changes.
# Selected values: 14-day lifetime (activity start caps it), 10 creates per
# identity and 60 per IP, 120 resolutions per IP, one-hour window.
INVITE_EXPIRY_HOURS=336
INVITE_RATE_LIMIT_PER_IDENTITY=10
INVITE_RATE_LIMIT_PER_IP=60
INVITE_RESOLVE_RATE_LIMIT_PER_IP=120
INVITE_RATE_WINDOW_SECONDS=3600
# Client observation events (PLANS.md 4.1, POST /client-events): allowlisted
# display/interaction observations with client event + visitor UUIDs. Bounded
# fixed-window quota per IP; observations never claim delivery or conversion.
# Selected values: 240 events per IP, one-hour window.
CLIENT_EVENT_RATE_LIMIT_PER_IP=240
CLIENT_EVENT_RATE_WINDOW_SECONDS=3600
# Live availability (PLANS.md 3.4): after a booking commits, its activity id,
# availability version, remaining spots and committed event id are published
# to the environment-prefixed Redis channel <LIVE_CHANNEL_PREFIX>:availability
# with this finite budget. Publication failures never change the booking
# outcome; viewers recover through snapshots (websocket /live protocol
# documented in README.md). Selected values: 500 ms budget, local prefix.
LIVE_PUBLISH_TIMEOUT_MS=500
LIVE_CHANNEL_PREFIX=velio-local
# Applied-availability measurement (PLANS.md 4.2, ticket #11): server-owned
# presence for measurement-registered live connections with a finite liveness
# lease (renewed by the owning instance; expiry stands in for a crash's
# missing close event), and a bounded per-IP ack quota. LIVE_INSTANCE_ID
# labels the owning instance; it defaults to a per-boot UUID.
LIVE_LEASE_SECONDS=30
AVAILABILITY_ACK_RATE_LIMIT_PER_IP=240
AVAILABILITY_ACK_RATE_WINDOW_SECONDS=3600
LOG_LEVEL=info
